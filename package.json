{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "push-test": "git push origin develop && git checkout test && git merge develop && git push && git checkout develop",
    "push-prod": "git push origin develop && git checkout prod && git merge test && git push && git checkout develop",

    "ng": "ng",

    "dev": "ng serve --port 3010 --define STAGE='\"local\"'",

    "build": "ng build --define STAGE='\"local\"'",
    "build:test": "ng build --define STAGE='\"test\"'",
    "build:prod": "ng build --define STAGE='\"prod\"'",

    "watch": "ng build --watch --define STAGE='\"local\"'",

    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}